# 股伴 StockMate - 环境配置模板（不要填写到仓库中）
# 首次复制为 .env；保留已有 .env，勿覆盖现有密钥。

# 模型：填写自己的密钥及服务商提供的 OpenAI 兼容接口地址。
# 当前验证使用 qwen3.8-flash；专属业务空间应使用其对应的兼容接口。
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=qwen3.8-flash
OPENAI_TEMPERATURE=0.6
OPENAI_THINKING=disabled
# 0 表示不额外施加进程内 RPM 限速，仍受服务商实际配额限制。
OPENAI_REQUESTS_PER_MINUTE=0
CONTEXT_COMPRESS_THRESHOLD=20000

# 飞书（可选，需另行安装 lark-oapi 并配置机器人权限）
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_REPORT_USERS=your-open-id
# FEISHU_ALERT_USERS=your-open-id

# 企业微信应用（可选，Webhook 需能被企业微信访问）
# WECOM_CORP_ID=your-corp-id
# WECOM_CORP_SECRET=your-corp-secret
# WECOM_AGENT_ID=your-agent-id
# WECOM_WEBHOOK_PORT=8080
# WECOM_TOKEN=your-verification-token
# WECOM_ENCODING_AES_KEY=your-encryption-key
# WECOM_REPORT_USERS=your-user-id
# WECOM_ALERT_USERS=your-user-id

# 内置固定早报和监控时间表在 config.py 配置。
# 用户创建的定时任务由网页／对话管理，普通 --web 模式即可执行。
