# A股分析Agent系统 - 环境变量配置

# ==========================================
# OpenAI API配置 (必需)
# ==========================================
# OpenAI API密钥（填入你自己的密钥）
OPENAI_API_KEY=sk-your-api-key

# OpenAI API基础地址（可选，使用第三方API时配置）
OPENAI_API_BASE=https://api.moonshot.cn/v1

# 使用的模型
OPENAI_MODEL=kimi-k2.5

# 温度参数 (注意: Moonshot kimi-k2.5 只支持 temperature=1)
OPENAI_TEMPERATURE=1

# ==========================================
# 监控配置 (可选)
# ==========================================
# 监控间隔（秒）
MONITOR_INTERVAL=30

# 价格异动阈值（%）
# PRICE_CHANGE_THRESHOLD=3.0

# ==========================================
# 通知配置 (可选)
# ==========================================
# 通知渠道，多个用逗号分隔: console,dingtalk,wecom
NOTIFICATION_CHANNELS=console

# 钉钉Webhook（使用钉钉通知时填写）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=your_secret

# 企业微信Webhook（使用企业微信通知时填写）
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ==========================================
# 企业微信应用配置 (用于双向通信)
# ==========================================
# 企业ID（从企业微信管理后台获取）
# WECOM_CORP_ID=xxxxxxxxxxxxxxxx

# 应用凭证密钥（从企业微信管理后台获取）
# WECOM_CORP_SECRET=xxxxxxxxxxxxxxxx

# 应用ID（从企业微信管理后台获取）
# WECOM_AGENT_ID=1000002

# Webhook接收端口（企业微信推送消息的端口）
# WECOM_WEBHOOK_PORT=8080

# Token（用于验证URL，可选但建议配置）
# WECOM_TOKEN=your_token

# EncodingAESKey（用于消息加密，可选）
# WECOM_ENCODING_AES_KEY=your_aes_key

# 晨报发送目标用户（多个用逗号分隔）
# WECOM_REPORT_USERS=ZhangSan,LiSi

# 预警发送目标用户（多个用逗号分隔）
# WECOM_ALERT_USERS=ZhangSan,LiSi

# ==========================================
# 飞书配置 (可选，用于双向通信)
# ==========================================
# 飞书开放平台应用凭证
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 消息加密密钥（可选）
# FEISHU_ENCRYPT_KEY=

# 验证 Token（可选）
# FEISHU_VERIFICATION_TOKEN=

# 晨报发送目标用户（多个用逗号分隔，使用用户的open_id）
# FEISHU_REPORT_USERS=ou_xxxxxxxxxxxxxxxx

# 预警发送目标用户（多个用逗号分隔，使用用户的open_id）
# FEISHU_ALERT_USERS=ou_xxxxxxxxxxxxxxxx

# ==========================================
# 定时任务配置 (可选)
# ==========================================
# 早间报告时间
MORNING_REPORT_TIME=09:00
